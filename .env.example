# Keep secrets server-side. Offline simulation needs none.
BOLNA_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
# Provider selection: auto prefers Groq when configured, then OpenAI.
EVALUATOR_PROVIDER=auto
TRANSCRIPTION_PROVIDER=auto
EVALUATOR_MODEL=gpt-4.1-mini
TRANSCRIPTION_MODEL=whisper-1
GROQ_EVALUATOR_MODEL=openai/gpt-oss-20b
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
ALLOWED_TEST_NUMBERS=
# Bolna sender number for API-dispatched calls; leave empty to use the account default.
BOLNA_FROM_PHONE_NUMBER=
MAX_LIVE_CALLS_PER_DAY=5
TOOL_ENDPOINT_TOKEN=
TOOL_SUBJECT_ID=SYN-001
WEBHOOK_SECRET=
# Bind locally. Shared deployments require an authenticated reverse proxy.
SENTINEL_API_TOKEN=
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SENTINEL_DATA_DIR=data
# Prompt evaluation roles (Groq). Hosted Bolna model configuration is separate.
TARGET_MODEL=openai/gpt-oss-20b
ATTACKER_MODEL=qwen/qwen3.8-27b
REDTEAM_MODEL=openai/gpt-oss-120b
# Optional comma-separated exact HTTPS recording hosts. Signed/public URLs only.
RECORDING_ALLOWED_HOSTS=
# Hosted frontend only: set these in Render's web-service environment.
# Requires a 24+ character password and the same 32+ character API token on both services.
SENTINEL_REQUIRE_AUTH=false
SENTINEL_WEB_USERNAME=
SENTINEL_WEB_PASSWORD=
