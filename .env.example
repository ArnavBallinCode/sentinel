# Keep secrets server-side. Offline simulation needs none.
BOLNA_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
# Provider selection: auto prefers Groq when configured, then OpenAI.
EVALUATOR_PROVIDER=auto
TRANSCRIPTION_PROVIDER=auto
EVALUATOR_MODEL=gpt-4.1-mini
TRANSCRIPTION_MODEL=whisper-1
GROQ_EVALUATOR_MODEL=openai/gpt-oss-20b
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
ALLOWED_TEST_NUMBERS=
MAX_LIVE_CALLS_PER_DAY=5
TOOL_ENDPOINT_TOKEN=
TOOL_SUBJECT_ID=SYN-001
WEBHOOK_SECRET=
# Bind locally. Shared deployments require an authenticated reverse proxy.
SENTINEL_API_TOKEN=
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SENTINEL_DATA_DIR=data
